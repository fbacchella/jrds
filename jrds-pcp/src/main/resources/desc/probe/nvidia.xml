<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE probedesc PUBLIC "-//jrds//DTD Probe Description//EN" "urn:jrds:probedesc">
<probedesc>
    <name>PcpNvidia</name>
    <probeName>nvidia-${index}</probeName>
    <probeClass>jrds.pcp.probe.PcpProbeIndexed</probeClass>
    <ds>
        <dsName>temperature</dsName>
        <dsType>gauge</dsType>
        <collect>nvidia.temperature</collect>
    </ds>
    <ds>
        <dsName>perfstate</dsName>
        <dsType>gauge</dsType>
        <collect>nvidia.perfstate</collect>
    </ds>
    <ds>
        <dsName>gpuactive</dsName>
        <dsType>gauge</dsType>
        <collect>nvidia.gpuactive</collect>
    </ds>
    <ds>
        <dsName>memactive</dsName>
        <dsType>gauge</dsType>
        <collect>nvidia.memactive</collect>
    </ds>
    <ds>
        <dsName>memused</dsName>
        <dsType>gauge</dsType>
        <collect>nvidia.memused</collect>
    </ds>
    <ds>
        <dsName>memtotal</dsName>
        <dsType>gauge</dsType>
        <collect>nvidia.memtotal</collect>
    </ds>
    <ds>
        <dsName>memfree</dsName>
        <dsType>gauge</dsType>
        <collect>nvidia.memfree</collect>
    </ds>
    <ds>
        <dsName>energy</dsName>
        <dsType>counter</dsType>
        <collect>nvidia.energy</collect>
    </ds>
    <ds>
        <dsName>power</dsName>
        <dsType>gauge</dsType>
        <collect>nvidia.power</collect>
    </ds>
    <ds>
        <dsName>nprocs</dsName>
        <dsType>gauge</dsType>
        <collect>nvidia.nprocs</collect>
    </ds>
    <ds>
        <dsName>gpuutilaccum</dsName>
        <dsType>counter</dsType>
        <collect>nvidia.gpuutilaccum</collect>
    </ds>
    <ds>
        <dsName>memutilaccum</dsName>
        <dsType>counter</dsType>
        <collect>nvidia.memutilaccum</collect>
    </ds>
    <ds>
        <dsName>memusedaccum</dsName>
        <dsType>counter</dsType>
        <collect>nvidia.memusedaccum</collect>
    </ds>
    <graphs>
        <name>PcpNvidiaMemory</name>
        <name>PcpNvidiaEnergy</name>
        <name>PcpNvidiaTemperature</name>
        <name>PcpNvidiaNProcs</name>
    </graphs>
</probedesc>
