<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE graphdesc PUBLIC "-//jrds//DTD Graph Description//EN"
                           "urn:jrds:graphdesc">
<graphdesc>
    <name>PcpNvidiaEnergy</name>
    <graphName>nvenergy-${index}</graphName>
    <graphTitle>Energy consumption on GPU ${index} on ${host}</graphTitle>
    <verticalLabel>Watt</verticalLabel>
    <add>
        <name>energy</name>
    </add>
    <add>
        <rpn>energy,1000,/</rpn>
        <graphType>line</graphType>
        <color>blue</color>
        <legend>GPU energy consumption</legend>
    </add>
    <hosttree>
        <pathelement>HOST</pathelement>
        <pathstring>nVidia GPU</pathstring>
        <pathstring>Energy</pathstring>
        <pathelement>INDEX</pathelement>
    </hosttree>
    <viewtree>
        <pathstring>nVidia GPU</pathstring>
        <pathstring>Energy</pathstring>
        <pathelement>HOST</pathelement>
        <pathelement>INDEX</pathelement>
    </viewtree>
</graphdesc>
