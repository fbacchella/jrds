<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE graphdesc PUBLIC "-//jrds//DTD Graph Description//EN"
                           "urn:jrds:graphdesc">
<graphdesc>
    <name>PcpNvidiaNProcs</name>
    <graphName>nvnprocs-${index}</graphName>
    <graphTitle>Number of processes on GPU ${index} on ${host}</graphTitle>
    <verticalLabel>proc</verticalLabel>
    <add>
        <name>nprocs</name>
        <graphType>line</graphType>
        <color>green</color>
        <legend>Count of processes using each GPU</legend>
    </add>
    <hosttree>
        <pathelement>HOST</pathelement>
        <pathstring>nVidia GPU</pathstring>
        <pathstring>Processes</pathstring>
        <pathelement>INDEX</pathelement>
    </hosttree>
    <viewtree>
        <pathstring>nVidia GPU</pathstring>
        <pathstring>Processes</pathstring>
        <pathelement>HOST</pathelement>
        <pathelement>INDEX</pathelement>
    </viewtree>
</graphdesc>
