<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE graphdesc PUBLIC "-//jrds//DTD Graph Description//EN"
                           "urn:jrds:graphdesc">
<graphdesc>
    <name>PcpNvidiaTemperature</name>
    <graphName>nvtemp-${index}</graphName>
    <graphTitle>Temperature of GPU ${index} on ${host}</graphTitle>
    <verticalLabel>°C</verticalLabel>
    <add>
        <name>temperature</name>
        <graphType>line</graphType>
        <color>green</color>
        <legend>The temperature of the card</legend>
    </add>
    <hosttree>
        <pathelement>HOST</pathelement>
        <pathstring>nVidia GPU</pathstring>
        <pathstring>Temperature</pathstring>
        <pathelement>INDEX</pathelement>
    </hosttree>
    <viewtree>
        <pathstring>nVidia GPU</pathstring>
        <pathstring>Temperature</pathstring>
        <pathelement>HOST</pathelement>
        <pathelement>INDEX</pathelement>
    </viewtree>
</graphdesc>
