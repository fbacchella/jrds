<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE graphdesc PUBLIC "-//jrds//DTD Graph Description//EN"
                           "urn:jrds:graphdesc">
<graphdesc>
    <name>PcpNvidiaMemory</name>
    <graphName>nvmem-${index}</graphName>
    <graphTitle>Memory usage on GPU ${index} on ${host}</graphTitle>
    <unit>
        <binary />
    </unit>
    <verticalLabel>Bytes</verticalLabel>
    <add>
        <name>memtotal</name>
        <graphType>line</graphType>
        <color>red</color>
        <legend>Total memory on GPU</legend>
    </add>
    <add>
        <name>memused</name>
        <graphType>area</graphType>
        <color>blue</color>
        <legend>Allocated frame buffer memory</legend>
    </add>
    <add>
        <name>memfree</name>
        <graphType>stack</graphType>
        <color>green</color>
        <legend>Unallocated frame buffer memory</legend>
    </add>
    <hosttree>
        <pathelement>HOST</pathelement>
        <pathstring>nVidia GPU</pathstring>
        <pathstring>Memory</pathstring>
        <pathelement>INDEX</pathelement>
    </hosttree>
    <viewtree>
        <pathstring>nVidia GPU</pathstring>
        <pathstring>Memory</pathstring>
        <pathelement>HOST</pathelement>
        <pathelement>INDEX</pathelement>
    </viewtree>
</graphdesc>
