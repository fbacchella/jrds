<!DOCTYPE graphdesc PUBLIC "-//jrds//DTD Graph Description//EN" "urn:jrds:graphdesc">
<graphdesc>
  <name>pgsqltup</name>
  <graphName>pgsqltup-${index}</graphName>
  <graphTitle>PostgreSQL rows activity on ${index}</graphTitle>
  <verticalLabel>Rows activity/s</verticalLabel>

  <add>
    <name>tup_returned</name>
    <graphType>area</graphType>
    <legend>Rows returned by queries</legend>
  </add>
  <add>
    <name>tup_fetched</name>
    <graphType>stack</graphType>
    <legend>Rows fetched via index scans or table access</legend>
  </add>
  <add>
    <name>tup_inserted</name>
    <graphType>stack</graphType>
    <legend>Rows inserted</legend>
  </add>
  <add>
    <name>tup_updated</name>
    <graphType>stack</graphType>
    <legend>Rows updated</legend>
  </add>
  <add>
    <name>tup_deleted</name>
    <graphType>stack</graphType>
    <legend>Rows deleted</legend>
  </add>

  <hosttree>
    <pathelement>HOST</pathelement>
    <pathelement>SERVICES</pathelement>
    <pathelement>URL</pathelement>
    <pathstring>${index}</pathstring>
    <pathstring>Rows activity</pathstring>
  </hosttree>
  <viewtree>
    <pathelement>SERVICES</pathelement>
    <pathstring>Postgresql</pathstring>
    <pathelement>URL</pathelement>
    <pathstring>${index}</pathstring>
    <pathstring>Rows activity</pathstring>
  </viewtree>
</graphdesc>
