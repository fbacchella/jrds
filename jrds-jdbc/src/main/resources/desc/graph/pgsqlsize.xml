<!DOCTYPE graphdesc PUBLIC "-//jrds//DTD Graph Description//EN" "urn:jrds:graphdesc">
<graphdesc>
  <name>pgsqlsize</name>
  <graphName>pgsize-${index}</graphName>
  <graphTitle>PostgreSQL database ${index} size on ${host}</graphTitle>
  <unit>
    <binary/>
  </unit>
  <verticalLabel>bytes</verticalLabel>

  <add>
    <name>pg_database_size</name>
    <graphType>area</graphType>
    <legend>Database size</legend>
  </add>

  <hosttree>
    <pathelement>HOST</pathelement>
    <pathelement>SERVICES</pathelement>
    <pathelement>URL</pathelement>
    <pathstring>${index}</pathstring>
    <pathstring>Size</pathstring>
  </hosttree>
  <viewtree>
    <pathelement>SERVICES</pathelement>
    <pathstring>Postgresql</pathstring>
    <pathelement>URL</pathelement>
    <pathstring>${index}</pathstring>
    <pathstring>Size</pathstring>
  </viewtree>
</graphdesc>
